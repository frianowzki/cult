# Aptos contract addresses (set after deploying the Move module)
VITE_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_ADDRESS
VITE_PLATFORM_ADDRESS=0xYOUR_PLATFORM_WALLET_ADDRESS

# Shelby
VITE_SHELBY_GATEWAY=https://gateway.shelby.network

# Server-only secrets (do NOT use VITE_ prefix)
APTOS_API_KEY=your_aptos_api_key_here
SHELBY_API_KEY=your_shelby_api_key_here
